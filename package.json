{
  "name": "balzani-apresentacao",
  "productName": "Apresentação Balzani",
  "description": "Apresentação comercial Balzani",
  "author": "Balzani",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "release": "npm version patch -m \"Versão %s\" && git push --follow-tags && node scripts/release-github.cjs criar && vite build && electron-builder --win --publish always && node scripts/release-github.cjs publicar"
  },
  "build": {
    "appId": "br.com.balzani.apresentacao",
    "productName": "Apresentação Balzani",
    "artifactName": "Apresentacao-Balzani-Setup-${version}.${ext}",
    "directories": {
      "output": "${env.LOCALAPPDATA}/balzani-release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apresentação Balzani"
    },
    "publish": {
      "provider": "github",
      "owner": "Riizzy-IV",
      "repo": "apresentacao-comercial",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "gsap": "^3.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "vite": "^8.0.10"
  }
}
